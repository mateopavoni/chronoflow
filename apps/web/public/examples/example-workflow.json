{
  "name": "Example: fetch + transform",
  "description": "Minimal importable workflow — start, an HTTP call, a mapping, then end.",
  "graph": {
    "nodes": [
      {
        "id": "start-1",
        "type": "start",
        "position": { "x": 80, "y": 160 },
        "data": { "label": "Start", "config": {} }
      },
      {
        "id": "http-1",
        "type": "http",
        "position": { "x": 320, "y": 160 },
        "data": {
          "label": "Fetch user",
          "config": { "method": "GET", "url": "https://jsonplaceholder.typicode.com/users/1" }
        }
      },
      {
        "id": "transform-1",
        "type": "transform",
        "position": { "x": 560, "y": 160 },
        "data": {
          "label": "Map fields",
          "config": { "mappings": { "userName": "$.http-1.body.name", "userEmail": "$.http-1.body.email" } }
        }
      },
      {
        "id": "end-1",
        "type": "end",
        "position": { "x": 800, "y": 160 },
        "data": { "label": "End", "config": {} }
      }
    ],
    "edges": [
      { "id": "edge-1", "source": "start-1", "target": "http-1" },
      { "id": "edge-2", "source": "http-1", "target": "transform-1" },
      { "id": "edge-3", "source": "transform-1", "target": "end-1" }
    ]
  }
}
